@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "System Selection";
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payroll Dashboard</title>
    <link rel="stylesheet" href="~/css/hr-dashboard.css" />
    <link rel="stylesheet" href="~/css/hr-dashboard.css" />
    <link rel="stylesheet" href="~/css/Salarydef.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <header class="nav-header">
        <div class="header-container">
            <div class="brand-logo">
                <img src="~/assets/images/logo/HKDR_LOGO.png" alt="UIUXOtor Logo">
                <div class="brand-text">
                    <span class="brand-name">HKDR</span>
                    <span class="brand-subtext">ERP System</span>
                </div>
            </div>

            <nav class="top-nav">
                <ul class="nav-list">
                    <li>
                        <a href="/HR/HrDashBoard/HrDashBoard" class="btn btn-primary">
                            <i class="fa-solid fa-gauge-high"></i> Dash Board
                        </a>
                    </li>
                    <li>
                        <a asp-area="HR"
                           asp-controller="Employees"
                           asp-action="Index"
                           class="btn-nav">
                            View Employees
                        </a>
                    </li>
                    <li>
                        <a asp-area="HR" asp-controller="Employees" asp-action="SalaryDef">
                            <i class="icon-staff"></i> Salary Definition
                        </a>
                    </li>
                    <li class="active"><a href="#"><i class="icon-payroll"></i> Payroll</a></li>
                    <li><a href="#"><i class="icon-memo"></i> Memo</a></li>
                    <li><a href="#"><i class="icon-circulars"></i> Circulars</a></li>
                    <li><a href="#"><i class="icon-maintenance"></i> Maintenance</a></li>
                    <li><a href="#"><i class="icon-logistics"></i> Logistics</a></li>
                    <li><a href="#"><i class="icon-notif"></i> Notifications</a></li>
                </ul>
            </nav>
        </div>
    </header>
<div class="page-container">
    

    <main class="content-card">
        <h2 class="form-title">Create Salary Definition</h2>

        <form class="salary-form">
            <div class="form-grid">
                <div class="input-field">
                    <label>Title</label>
                    <select>
                        <option>Select option</option>
                    </select>
                </div>
                <div class="input-field">
                    <label>Level</label>
                    <select>
                        <option>Select option</option>
                    </select>
                </div>
                <div class="input-field">
                    <label>Basic salary</label>
                    <input type="text" placeholder="Enter amount in Naira">
                </div>

                <div class="input-field">
                    <label>Allowance</label>
                    <input type="text" placeholder="Enter amount in Naira">
                </div>
                <div class="input-field">
                    <label>Gross Salary</label>
                    <input type="text" placeholder="Enter amount in Naira">
                </div>
                <div class="input-field">
                    <label>Deductions</label>
                    <input type="text" placeholder="Enter amount in Naira">
                </div>

                <div class="input-field">
                    <label>Net Salary</label>
                    <input type="text" placeholder="Enter amount in Naira">
                </div>
            </div>

            <button type="submit" class="btn-create">Create</button>
        </form>
    </main>

    <footer class="page-footer">
        Copyright © 2026 HKDR Digital Solutions. All Rights Reserved
    </footer>
</div>
</body>
</html>